# ---------------------------------------------------------------------------
# PoshanNetra AI - backend environment (Phase 1)
# Copy to `.env` and fill in your own Supabase values. `.env` is gitignored.
# See docs/phase1-supabase-setup.md for where each value lives in the dashboard.
# ---------------------------------------------------------------------------

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# --- Postgres -------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# -> "Session pooler" (port 5432). NOT the transaction pooler (6543):
# `SET LOCAL` and asyncpg prepared statements are both safer on the session pooler.
# Rewrite the scheme to postgresql+asyncpg://
# Supabase -> Connect -> Session pooler (port 5432; NOT the 6543 transaction
# pooler, which breaks row-level security). Paste the URI as given: the
# postgresql:// scheme is rewritten to postgresql+asyncpg:// for you, and the
# `psql "..."` wrapper shown in the dialog is unwrapped. Leaving the
# placeholders below in place is refused rather than silently accepted.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Alembic runs async against this same URL - no second driver needed.

# --- Supabase API / Storage ----------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key - server-side only, never ship to a client>
SUPABASE_STORAGE_BUCKET=plate-photos

# --- JWT ------------------------------------------------------------------
# Project Settings -> API -> JWT Keys -> legacy JWT secret (HS256).
# Signing our tokens with Supabase's own secret is what lets the SAME token be
# validated by Postgres RLS and by Supabase Storage. If your project only offers
# the newer asymmetric signing keys, see docs/phase1-supabase-setup.md step 6.
SUPABASE_JWT_SECRET=<legacy HS256 JWT secret>
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=3600            # Section 11: short-lived tokens

# Storage access mode: "rls" (token-scoped, preferred) or "service" (fallback,
# backend-mediated with app-level scope checks). See docs/phase1-supabase-setup.md.
STORAGE_MODE=rls

# --- Seed -----------------------------------------------------------------
SEED_RANDOM_SEED=20260828       # fixed => deterministic, reproducible sample data
SEED_UPLOAD_PHOTOS=true         # set false to skip Storage uploads when seeding offline

# --- Phase 2: AI pipeline (Section 4 -- zero paid APIs, free tiers only) ---
# "mock" is the default deliberately: it is deterministic, offline, and spends
# no quota. CI and the test suite must never depend on a live free-tier endpoint.
AI_PROVIDER=mock                # mock | gemini | groq
AI_ENABLED=true                 # false => captures stay 'pending', as in Phase 1
AI_VISION_MODEL=gemini/gemini-2.0-flash
AI_TEXT_MODEL=groq/llama-3.3-70b-versatile

# Google AI Studio (free tier)  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier)              -> https://console.groq.com/keys
GROQ_API_KEY=

# --- Phase 6: authentication (Sections 4, 10, 11) --------------------------
# Delivery channel for the one-time code. The code itself is always generated,
# hashed, expired and verified by this system -- a provider only delivers it, so
# the throttle and attempt limit apply either way.
#
# "console" logs the code instead of sending it and is the default, so nothing
# spends SMS credits by accident and CI never depends on a third party.
OTP_PROVIDER=console            # console | msg91

# MSG91 (Section 4's named provider). Needs an account, an authkey, and a
# DLT-approved template registered with your sender ID -- Indian regulation
# requires the template before any transactional SMS will be delivered.
# See docs/phase6-auth-setup.md.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=

# Section 11 wants short-lived access tokens; Section 7 wants the Field PWA to
# work through days offline. JWT_TTL_SECONDS above is the access token; this is
# the refresh token the device holds so it can renew without a sign-in.
REFRESH_TTL_DAYS=30

# --- Deployment (Section 13) ----------------------------------------------
# APP_ENV: development | test | demo | production
#   "demo" is as hardened as production -- no debug output, explicit CORS --
#   but permits seeding, which Section 14 step 1's pitch build needs.
#   "production" refuses to seed and disables every demo affordance.
#
# Every frontend origin, comma separated. Empty in a deployment means CORS
# blocks all three apps, so this is not optional.
ALLOWED_ORIGINS=

# Returns the one-time code in the API response for the seeded 99999xxxxx
# numbers only, so a deployed demo is usable without SMS credits. An open door
# by design -- only for a database holding nothing but synthetic data. Ignored
# entirely when APP_ENV=production.
DEMO_REVEAL_OTP=false
